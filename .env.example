# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Email (Resend)
RESEND_API_KEY=
# Verified sender used for booking, contact, and claim notification emails.
RESEND_FROM_EMAIL="TattooMaps <bookings@tattoo-maps.com>"
# Reply-To address on emails sent to clients, claimants and artists.
RESEND_REPLY_TO=you@example.com

# Admin
# Comma-separated emails allowed into the admin area.
ADMIN_EMAILS=you@example.com
# Where admin notification emails (new bookings, claims, contact) are sent.
ADMIN_NOTIFY_EMAIL=you@example.com
# Shared secret for cron endpoints — generate with: openssl rand -hex 32
CRON_SECRET=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: flash-chart Mapbox Studio style (mapbox://styles/<user>/<id>). Falls back to light-v11.
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# AI generator (feature currently disabled — see app/api/generator/route.ts)
REPLICATE_API_TOKEN=

# AI (misc)
ANTHROPIC_API_KEY=
